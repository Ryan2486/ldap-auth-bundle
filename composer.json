{
    "name": "ro/ldap-auth-bundle",
    "description": "Configurable LDAP authentication bundle with an overridable Twig login form.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": ">=8.2",
        "ext-ldap": "*",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/ldap": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/security-http": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "LdapAuthBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LdapAuthBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
